# --------------------------------------------------
# Aplicación base
# Identidad y comportamiento general de Laravel.
# APP_KEY es obligatoria en cualquier entorno.
# --------------------------------------------------
APP_NAME=OpenClassy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------
# Frontend y CORS
# URL pública del frontend SPA y orígenes permitidos para llamadas al backend.
# CORS_ALLOWED_ORIGINS acepta una lista separada por comas.
# --------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --------------------------------------------------
# Idioma y datos de prueba
# Ajustes de locale para la app y Faker.
# --------------------------------------------------
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# --------------------------------------------------
# Runtime, mantenimiento y seguridad básica
# Ajustes generales de ejecución, hash y logging.
# --------------------------------------------------
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------
# Base de datos
# Valores locales por defecto para PostgreSQL.
# Neon requiere DB_SSLMODE=require en producción.
# --------------------------------------------------
DB_CONNECTION=pgsql
DB_URL=postgresql://usuario:password@host/neondb?sslmode=require
DB_SSLMODE=require

# Para desarrollo local, puedes usar estas credenciales de PostgreSQL:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=openclassy
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

# --------------------------------------------------
# Sesión, caché, colas y broadcast
# Por defecto usamos drivers que no requieren tablas extra (file/sync),
# de modo que la app funciona nada más clonar sin depender de las tablas
# cache, sessions o jobs. Si prefieres usarlas, cambia a "database" y ejecuta
# `php artisan migrate` (las migraciones de cache/jobs/sessions ya existen).
# --------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=sync
CACHE_STORE=file
CACHE_PREFIX=

# --------------------------------------------------
# Almacenamiento de archivos
# local = disco del contenedor. s3 = bucket externo compatible con S3.
# --------------------------------------------------
FILESYSTEM_DISK=local

# --------------------------------------------------
# Redis / Memcached
# Solo se usan si decides levantar esos servicios.
# --------------------------------------------------
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --------------------------------------------------
# Correo
# En local se deja en log. En producción puedes usar SMTP real.
# --------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------
# AWS / S3 / servicios compatibles
# Opcional. Solo se usa si activas almacenamiento S3, colas SQS o caché DynamoDB.
# Si mantienes FILESYSTEM_DISK=local y no usas AWS, déjalo vacío.
# --------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --------------------------------------------------
# IA: OpenRouter
# Clave y parámetros para la corrección de la prueba de nivel.
# OPENROUTER_API_KEY es obligatoria si quieres usar esta funcionalidad.
# --------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-001
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_TIMEOUT=30
OPENROUTER_VERIFY_SSL=true
OPENROUTER_MAX_TOKENS=700

# --------------------------------------------------
# Ejemplo de despliegue en producción Render + Neon
# No copies credenciales reales aquí; configúralas en el panel de Render.
# Variables realmente necesarias para este proyecto:
# - APP_KEY
# - APP_ENV
# - APP_DEBUG
# - APP_URL
# - FRONTEND_URL
# - CORS_ALLOWED_ORIGINS
# - DB_HOST
# - DB_PORT
# - DB_DATABASE
# - DB_USERNAME
# - DB_PASSWORD
# - DB_SSLMODE
# - OPENROUTER_API_KEY
# Variables recomendadas en Render para simplificar infraestructura:
# - SESSION_DRIVER=cookie
# - CACHE_STORE=file
# - QUEUE_CONNECTION=sync
# --------------------------------------------------
# APP_KEY=base64:...
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://openclassy-api.onrender.com
# FRONTEND_URL=https://openclassy.onrender.com
# CORS_ALLOWED_ORIGINS=https://openclassy.onrender.com
# DB_HOST=ep-xxxx-xxxx.eu-central-1.aws.neon.tech
# DB_PORT=5432
# DB_DATABASE=neondb
# DB_USERNAME=neondb_owner
# DB_PASSWORD=tu-password-de-neon
# DB_SSLMODE=require
# SESSION_DRIVER=cookie
# CACHE_STORE=file
# QUEUE_CONNECTION=sync
# OPENROUTER_API_KEY=tu-api-key
# OPENROUTER_MODEL=google/gemini-2.0-flash-lite-001
